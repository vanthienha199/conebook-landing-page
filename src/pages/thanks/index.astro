---
import Base from "../../layouts/Base.astro";
---
<Base title="You are on the list, Conebook (demo site)" description="Thanks for joining the Conebook waitlist.">
  <main class="thanks">
    <p class="eyebrow">Waitlist</p>
    <h1>You are on the list.</h1>
    <p>Thanks for telling us about your studio. We will email you when a spot opens.</p>
    <a class="btn btn-primary" href={import.meta.env.BASE_URL}>Back to Conebook</a>
    <p class="note">Conebook is a fictional product made for a website demo.</p>
  </main>
</Base>
<style>
  .thanks { min-height: 100vh; display: grid; place-content: center; gap: 18px; text-align: center; padding: 24px; }
  .thanks h1 { font-size: clamp(44px, 7vw, 80px); }
  .thanks p { color: var(--ink-2); max-width: 44ch; margin-inline: auto; }
  .thanks .btn { justify-self: center; }
  .note { font-size: 14px; color: var(--muted) !important; }
</style>
